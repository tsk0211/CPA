# --- Required ---

# Free-tier MongoDB Atlas connection string (M0 cluster).
# Atlas dashboard -> Database -> Connect -> Drivers -> copy the string and
# put your real username/password/db name in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cpa?retryWrites=true&w=majority

# Must be at least 32 characters (enforced in src/config/security.ts).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# The single Owner account is created from these on the server's very
# first boot against an empty database, and never again — see
# src/seedOwner.ts. Rotate/remove these from the environment after first
# boot if you're being strict about it; they're only read when no owner
# exists yet.
OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-temp-password

# --- Optional (all have sane defaults — see src/config/security.ts) ---

PORT=4000
NODE_ENV=production

# Short-lived JWT — if one leaks, the exposure window is small. Long
# sessions come from the refresh token below, not this.
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token lifetime, in days. "Remember me" at login picks which one
# applies. Refresh tokens are opaque (not JWTs) and stored server-side as a
# hash, so they're individually revocable — e.g. the instant an account is
# deactivated, not just whenever the token happens to expire.
REFRESH_TOKEN_TTL_REMEMBER_ME_DAYS=30
REFRESH_TOKEN_TTL_DEFAULT_DAYS=1

# bcrypt cost factor. Higher = slower to hash = more resistant to
# brute-force, but slower logins/account-creation. 12 is a reasonable
# default for 2026 hardware.
BCRYPT_SALT_ROUNDS=12

# Minimum length for temp passwords and password changes.
MIN_PASSWORD_LENGTH=8

# Comma-separated allowed origins for browser clients. "*" is only fine for
# local dev / before a web frontend exists (the mobile app isn't subject to
# CORS at all) — the deployed v1.1.0 service (render.yaml) is locked to the
# actual GitHub Pages origin now that one does.
CORS_ORIGIN=*

# Brute-force protection on POST /auth/login specifically.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
