# Free-tier MongoDB Atlas connection string (M0 cluster).
# Atlas dashboard -> Database -> Connect -> Drivers -> copy the string and
# put your real username/password/db name in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cpa?retryWrites=true&w=majority

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
